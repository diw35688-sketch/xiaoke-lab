# 小科实验助手 — 实时语音引擎配置
# 只需要一行：DashScope API Key

# 必填：阿里云 DashScope API Key（开通 Qwen Audio Realtime 服务）
DASHSCOPE_API_KEY=

# 可选：Python 后端地址（默认 http://127.0.0.1:8000）
# LAB_ASSISTANT_BASE_URL=http://127.0.0.1:8000

# 可选：选择 DashScope Realtime 模型（默认 qwen-audio-3.0-realtime-plus）
# 可选值：qwen3.5-omni-flash-realtime、qwen-audio-3.0-realtime-flash
# QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
